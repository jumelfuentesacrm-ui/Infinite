{
  "name": "fleet-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema modular de administración de flota, operaciones y taller mecánico",
  "scripts": {
    "dev": "vite",
    "build": "npm run modules check && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "modules": "node scripts/modules.mjs",
    "db:test": "bash scripts/test-db.sh",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "demo": "npm run modules sync && vite --mode demo",
    "build:demo": "npm run modules sync && tsc -b && vite build --mode demo"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.67.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}